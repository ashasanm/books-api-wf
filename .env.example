# ==============================================================================
# ENVIRONMENT SETTINGS
# ==============================================================================

# 'dev' for local/staging, 'prod' for production logic toggles
STAGE=dev

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# For multiple origins, separate them with a comma (no spaces)
# Pydantic will split these into a list for FastAPI
ALLOWED_ORIGINS=https://your_app_url,http://localhost:3000

# ==============================================================================
# AWS & DYNAMODB CONFIGURATION
# ==============================================================================

# Matches the 'tableName' param in serverless.yml
# Format: books-api-dev-books-dev-books
DYNAMODB_TABLE=books-api-dev-books-dev-books

# Your AWS Region (ap-southeast-2 is your current setting)
AWS_ACCOUNT_REGION=ap-southeast-2

# AWS Credentials for local WSL access to DynamoDB
# Ensure these have 'AmazonDynamoDBFullAccess' or similar
AWS_SECRET_ACCESS_KEY=*YOUR_AWS_SECRET_ACCESS_KEY
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID

# ==============================================================================
# OPTIONAL LOCAL DEVELOPMENT
# ==============================================================================

# If using dynamodb-local or Docker, uncomment this:
# DYNAMODB_ENDPOINT_URL=http://localhost:8000