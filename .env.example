# Copy this file to .env and fill in the values for local development.
# Never commit .env to Git.

# DynamoDB table name (created automatically by Serverless on deploy)
DYNAMODB_TABLE=books-api-dev-books-example

# AWS region
AWS_ACCOUNT_REGION=ap-southeast-2-example

# Optional: point to a local DynamoDB instance (e.g. via Docker)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
